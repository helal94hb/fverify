# fverify configuration — copy to `.env` and fill in real values.
#
# Every FV_* secret below ships with a working DEV DEFAULT so a bare checkout
# runs. Those defaults are in the git history, so the service REFUSES TO START
# in production while any of them is still the default. Set real values here, or
# set FV_ALLOW_DEV_DEFAULTS=true for local development and tests.
#
# `.env` itself is gitignored — never commit real keys.

# --- local/dev escape hatch ---------------------------------------------------
# Leave UNSET in production. Set true for a bare local checkout or CI so the
# dev-default secrets are permitted.
# FV_ALLOW_DEV_DEFAULTS=true

# --- this service's own database ----------------------------------------------
# Postgres in production; the sqlite default is dev only. Never the banking DB.
# FV_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/fverify

# --- REQUIRED secrets in production (each has a published dev default) ---------

# At-rest encryption of stored face embeddings (Fernet). Rotating it makes every
# previously stored embedding unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FV_AT_REST_KEY=

# PEM RSA private key that unseals inbound `enc1:` credential envelopes. This
# service's OWN pair (kid fv-dev1), never the banking platform's. The public
# half is bundled in the app. An env value may use literal "\n" escapes.
FV_SEAL_PRIVATE_KEY_PEM=

# Salt for one-time-secret (OTP) hashing — any high-entropy per-environment value.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FV_OTP_HASH_SALT=

# AES-256-GCM key for OTPs exported to Agentys — 32 bytes, base64-encoded.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FV_OTP_EXPORT_KEY=

# The BANK's PUBLIC key — where a verified identity's name is sealed. Must be the
# real bank public key in production; the dev default seals to a keypair whose
# private half is in the BFF repo, so a verified subject could be opened by
# anyone holding it. A wrong key means the bank refuses the sign-in (fail closed).
FV_BANK_PUBLIC_KEY_PEM=
FV_BANK_KEY_ID=

# --- tuning (safe defaults; override only with intent) ------------------------
# FV_MATCH_THRESHOLD=0.8
# FV_DEDUP_THRESHOLD=0.85
# FV_OTP_LIVE=true
